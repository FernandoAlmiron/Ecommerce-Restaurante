-
-body.cliente .registrar-reserva {
-    width: 100%;
-    max-width: 260px;
-    display: flex;
-    flex-direction: column;
-    align-items: center;
-}
-
-body.cliente .registrar-reserva h1 {
-    margin: 48px 0 40px;
-    font-size: 30px;
-    font-weight: 400;
-    line-height: 1.6;
-    text-align: center;
-}
-
-body.cliente .registrar-reserva form {
-    width: 100%;
-    display: flex;
-    flex-direction: column;
-    gap: 12px;
-}
-
-/* la caja del campo: nombre | valor */
-body.cliente .campo {
-    display: flex;
-    border: 1px solid var(--negro);
-    border-radius: 8px;
-    overflow: hidden;
-}
-
-body.cliente .campo span {
-    flex: 1;
-    padding: 8px 10px;
-    border-right: 1px solid var(--negro);
-    font-size: 12px;
-    font-weight: 400;
