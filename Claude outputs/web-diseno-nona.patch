diff --git a/web/src/main/resources/static/css/paginas/nosotros.css b/web/src/main/resources/static/css/paginas/nosotros.css
new file mode 100644
index 0000000..15d0d4f
--- /dev/null
+++ b/web/src/main/resources/static/css/paginas/nosotros.css
