+++ b/web/src/main/resources/static/css/componentes/comunes.css
@@ -0,0 +1,475 @@
+/* Piezas que usan varias páginas: logo, botones, campos, avisos, contador, barra de abajo, tarjetas */
+
+/* COMPONENTES COMUNES */
+
+/* Logo */
+
+body.cliente .logo {
+    display: block;
+    width: 230px;
+    max-width: 70vw;
+    height: auto;
+    margin: 0 auto;
+}
+
+body.cliente.ancho > header {
+    text-align: center;
+    margin-bottom: 16px;
+}
+
+body.cliente.ancho > header .logo {
+    width: 150px;
+}
+
+
+/* Botones */
+
+/* siver para botones y para los que estan asigandos con clase boton */
+body.cliente button,
+body.cliente .boton {
+    display: inline-block;
+    width: 100%;
+    padding: 10px 20px;
+    border: none;
+    border-radius: var(--radio);
+    background: var(--dorado);
+    color: var(--blanco);
+    font-family: var(--fuente);
+    font-size: 15px;
+    font-weight: 400;
+    text-align: center;
+    cursor: pointer;
+    transition: background 0.2s;
+}
+
+body.cliente button:hover,
+body.cliente .boton:hover {
+    background: var(--dorado-oscuro);
+    text-decoration: none;
+}
+
+/* dorado con flecha de continuar pago  → */
+body.cliente .boton-flecha {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 14px 18px;
+    border-radius: 12px;
+    color: var(--blanco);
+    font-weight: 500;
+}
+
+/* beige con sombra: "+ Nueva Reserva", "+ Nuevo pedido" */
+body.cliente .boton-beige {
+    padding: 8px 28px;
+    border-radius: 999px;
+    background: var(--beige);
+    color: var(--negro);
+    font-weight: 400;
+    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+}
+
+body.cliente .boton-beige:hover {
+    text-decoration: none;
+    filter: brightness(1.05);
+}
+
+/* blanco redondo, dentro de las tarjetas: "Ver Detalles", "Cancelar" */
+body.cliente .boton-blanco {
+    display: block;
+    width: 100%;
+    padding: 8px;
+    border-radius: 999px;
+    background: var(--blanco);
+    color: var(--negro);
+    text-align: center;
+    font-size: 13px;
+    font-weight: 400;
+    cursor: pointer;
+    list-style: none;   /* le saca el triangulito cuando es un <summary> */
+}
+
+body.cliente button.boton-blanco:hover,
+body.cliente a.boton-blanco:hover {
+    background: var(--beige-claro);
+    text-decoration: none;
+}
+
+body.cliente .texto-rojo {
+    color: #D62F22;
+}
+
+/* blanco con borde dorado: "Cancelar", "Contactar al restaurante" */
+body.cliente .boton-borde {
+    display: block;
+    padding: 9px;
+    border: 1px solid var(--dorado);
+    border-radius: var(--radio);
+    text-align: center;
+    font-weight: 400;
+}
+
+body.cliente .boton-borde:hover {
+    background: var(--beige-claro);
+    text-decoration: none;
+}
+
+/* apagado, no se puede tocar (como: Continuar al pago" con el carrito vacío no aparece) */
+body.cliente .deshabilitado {
+    opacity: 0.45;
+    pointer-events: none;
+}
+
+/* Cerrar sesion discreto, subrayado */
+body.cliente .cerrar-sesion button {
+    width: auto;
+    margin-top: 24px;
+    background: none;
+    color: var(--gris-texto);
+    font-size: 13px;
+    text-decoration: underline;
+}
+
+body.cliente .cerrar-sesion button:hover {
+    background: none;
+    color: var(--negro);
+}
+
+
+/*Campos de texto */
+
+body.cliente input,
+body.cliente select,
+body.cliente textarea {
+    width: 100%;
+    padding: 10px 12px;
+    border: 1px solid transparent;
+    border-radius: 6px;
+    background: var(--gris-input);
+    font-family: var(--fuente);
+    font-size: 14px;
+    color: var(--negro);
+}
+
+body.cliente input::placeholder,
+body.cliente textarea::placeholder {
+    color: var(--gris-texto);
+}
+
+/* al hacer click en un campo se marca con el dorado */
+body.cliente input:focus,
+body.cliente select:focus,
+body.cliente textarea:focus {
+    outline: none;
+    border-color: var(--dorado);
+    background: var(--blanco);
+}
+
+/* dos campos en la misma fila (nombre y apellido) */
+body.cliente .fila {
+    display: flex;
+    gap: 8px;
+}
+
+/* sacar las flechitas de los campos numericos (DNI, comensales) */
+body.cliente input[type="number"]::-webkit-inner-spin-button,
+body.cliente input[type="number"]::-webkit-outer-spin-button {
+    -webkit-appearance: none;
+    margin: 0;
+}
+
+body.cliente input[type="number"] {
+    -moz-appearance: textfield;
+}
+
+
+/* Avisos */
+
+body.cliente .alerta {
+    width: 100%;
+    margin: 0 0 12px;
+    padding: 10px 14px;
+    border-radius: var(--radio);
+    font-size: 14px;
+    text-align: center;
+}
+
+body.cliente .alerta.error {
+    background: #FDECEA;
+    color: var(--error);
+}
+
+body.cliente .alerta.ok {
+    background: #E8F5E9;
+    color: var(--ok);
+}
+
+
+/*  Etiquetas redondeadas pj platos cuando pedis,  ● Abierto ahora */
+
+body.cliente .chip {
+    display: inline-block;
+    padding: 3px 10px;
+    border-radius: 999px;
+    background: var(--beige-claro);
+    color: var(--dorado-texto);
+    font-size: 12px;
+    font-weight: 500;
+}
+
+body.cliente .chip.verde {
+    background: #E8F5E9;
+    color: var(--ok);
+}
+
+
+/* Contador − 2 + (carta del delivery y "Tu pedido")  */
+
+body.cliente .contador {
+    display: flex;
+    align-items: center;
+    gap: 4px;
+    padding: 3px;
+    border-radius: 10px;
+    background: var(--beige-claro);
+}
+
+body.cliente .contador button {
+    width: 30px;
+    padding: 4px 0;
+    background: none;
+    color: var(--dorado-texto);
+    font-size: 17px;
+}
+
+body.cliente .contador button:hover {
+    background: rgba(0, 0, 0, 0.06);
+}
+
+body.cliente .contador span {
+    min-width: 20px;
+    text-align: center;
+    font-weight: 500;
+}
+
+body.cliente .contador.chico {
+    align-self: flex-start;
+}
+
+body.cliente .contador.chico button {
+    width: 24px;
+    font-size: 15px;
+}
+
+
+/* Lista de platos con total
+   La usamos en Tu pedido, el pago y la confirmación: foto chica, nombre,
+   "2 × $13.500" y el subtotal a la derecha. */
+
+body.cliente .lineas {
+    margin: 0;
+    padding: 0;
+    list-style: none;
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+}
+
+body.cliente .lineas li {
+    display: flex;
+    align-items: flex-start;
+    gap: 12px;
+}
+
+body.cliente .lineas img {
+    width: 54px;
+    height: 54px;
+    flex-shrink: 0;
+    border-radius: 10px;
+    object-fit: cover;
+    background: var(--beige-claro);
+}
+
+body.cliente .linea-info {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    gap: 3px;
+    font-size: 13px;
+}
+
+body.cliente .linea-info strong {
+    font-weight: 500;
+}
+
+body.cliente .linea-info small {
+    color: var(--gris-texto);
+}
+
+/* título con dato a la derecha: "Tu pedido ........ 3 platos" */
+body.cliente .panel-titulo,
+body.cliente .resumen-titulo {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+}
+
+/* "Total de lo peidio $43.500" */
+body.cliente .total {
+    display: flex;
+    justify-content: space-between;
+    align-items: baseline;
+    padding-top: 14px;
+    border-top: 1px solid #EFE6DA;
+}
+
+body.cliente .total span {
+    font-size: 17px;
+    font-weight: 500;
+}
+
+body.cliente .total strong {
+    font-size: 24px;
+    font-weight: 700;
+}
+
+
+/* Barra de navegación de abajo
+   INICIO · PEDIDOS · RESERVAS · PERFIL. pagina q estamos marcada en ddorado */
+
+body.cliente .nav-inferior {
+    position: fixed;
+    bottom: 20px;
+    left: 50%;
+    transform: translateX(-50%);   /* centrada */
