+    padding: 8px 18px;
+    border-radius: 999px;
+    font-size: 12px;
+    font-weight: 500;
+    color: var(--negro);
+}
+
+body.cliente .nav-inferior a:hover {
+    text-decoration: none;
+    background: var(--beige-claro);
+}
+
+body.cliente .nav-inferior a.activo,
+body.cliente .nav-inferior a.activo:hover {
+    background: var(--dorado);
+}
+
+
+/* Tarjetas beige (Mis reservas y Mis pedidos)*/
+
+/* título centrado con un botón a la derecha */
+body.cliente .titulo-con-boton {
+    position: relative;
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    margin: 8px 0 28px;
+}
+
+body.cliente .titulo-con-boton h1 {
+    margin: 0;
+    font-size: 30px;
+    font-weight: 400;
