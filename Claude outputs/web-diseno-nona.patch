diff --git a/web/src/main/resources/static/css/paginas/delivery-pago.css b/web/src/main/resources/static/css/paginas/delivery-pago.css
new file mode 100644
index 0000000..b7dcca4
--- /dev/null
+++ b/web/src/main/resources/static/css/paginas/delivery-pago.css
@@ -0,0 +1,178 @@
+/* cliente/delivery-pago.html */
+
+/* ===================================================================
+   -- DELIVERY: PAGO --                    cliente/delivery-pago.html
+   Tres columnas: medio de pago (beige) · entrega y tarjeta · resumen.
+   ⚠️ ADAPTADO AL BACKEND: el pago es SIMULADO. Los datos de la tarjeta
+   no se envían ni se guardan; el backend solo guarda el método
+   (TARJETA, QR o EFECTIVO). Mercado Pago y MODO van como QR.
+   =================================================================== */
+
+body.cliente .pago {
+    width: 100%;
+    min-height: 100vh;
+    display: grid;
+    grid-template-columns: 320px 1fr 360px;
+    background: var(--blanco);
+}
+
+body.cliente .pago > section {
+    padding: 36px 32px;
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+}
+
+body.cliente .pago h3 {
+    margin: 10px 0 4px;
+    font-size: 17px;
+    font-weight: 500;
+}
+
+/* --- columna izquierda: medio de pago --- */
+body.cliente .pago-medios {
+    background: #F6F1EA;
+}
+
+body.cliente .pago-medios .chip {
+    align-self: flex-start;
+}
+
+body.cliente .pago-medios h1 {
+    margin: 4px 0 0;
+    font-size: 30px;
+    font-weight: 500;
+    line-height: 1.3;
+}
+
+body.cliente .pago-medios p {
+    margin: 0 0 12px;
+    color: var(--gris-texto);
+    font-size: 14px;
+}
+
+/* cada medio es una caja que se marca al elegirla */
+body.cliente .medio {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    padding: 12px 14px;
+    border: 1px solid #E6DED3;
+    border-radius: 12px;
+    background: var(--blanco);
+    cursor: pointer;
+}
+
+body.cliente .medio input {
+    order: 3;                 /* el circulito queda a la derecha, como en Figma */
+    width: 18px;
+    height: 18px;
+    padding: 0;
+    accent-color: var(--dorado);
+}
+
+body.cliente .medio div {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    font-size: 13px;
+}
+
+body.cliente .medio small {
+    color: var(--gris-texto);
+    font-size: 11px;
+}
+
+/* :has() = "la caja que TIENE adentro el circulito marcado" */
+body.cliente .medio:has(input:checked) {
+    border: 2px solid var(--dorado);
+    background: var(--beige-claro);
+}
+
+/* --- columna del centro: entrega y tarjeta --- */
+body.cliente .pago-datos {
+    position: relative;
+}
+
+body.cliente .pago-datos .logo.chico {
+    width: 90px;
+}
+
+body.cliente .pago-datos h2 {
+    margin: 0 0 8px;
+    text-align: center;
+    font-size: 18px;
+    font-weight: 500;
+}
+
+body.cliente .pago-datos label {
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+    font-size: 13px;
+    font-weight: 500;
+}
+
+body.cliente .pago-datos input {
+    padding: 12px;
+    border: 1px solid #EFE6DA;
+    background: var(--crema);
+}
+
+/* flechita "←" para volver a la carta */
+body.cliente .volver {
+    position: absolute;
+    top: 32px;
+    left: 32px;
+    width: 38px;
+    height: 38px;
+    border-radius: 50%;
+    background: var(--beige-claro);
+    display: grid;
+    place-items: center;
+}
+
+body.cliente .visa {
+    float: right;
+    color: var(--dorado-texto);
+    font-weight: 700;
+    font-style: italic;
+}
+
+/* los datos de la tarjeta solo se ven si está elegida "Tarjeta" */
+body.cliente .datos-tarjeta {
+    display: none;
+    flex-direction: column;
+    gap: 12px;
+}
+
+body.cliente .pago:has(input[value="TARJETA"]:checked) .datos-tarjeta {
+    display: flex;
+}
+
+body.cliente .datos-tarjeta .fila label {
+    flex: 1;
+}
+
+/* --- columna derecha: resumen --- */
+body.cliente .pago-resumen {
+    border-left: 1px solid #EFE6DA;
+}
+
+body.cliente .pago-resumen h3 {
+    margin: 0;
+}
+
+body.cliente .pago-resumen button {
+    margin-top: 8px;
+    justify-content: center;
+    gap: 10px;
+}
+
+body.cliente .nota-resumen {
+    margin: 0;
+    padding: 8px 10px;
+    border-radius: 8px;
+    background: var(--crema);
+    font-size: 12px;
+}
diff --git a/web/src/main/resources/static/css/paginas/delivery.css b/web/src/main/resources/static/css/paginas/delivery.css
new file mode 100644
index 0000000..95b6c59
--- /dev/null
+++ b/web/src/main/resources/static/css/paginas/delivery.css
@@ -0,0 +1,202 @@
+/* cliente/delivery.html */
+
+/* ===================================================================
+   -- DELIVERY: CARTA --                        cliente/delivery.html
+   Arriba la portada; abajo la grilla de platos (izquierda) y el panel
+   "Tu pedido" (derecha), que se queda quieto al bajar con el scroll.
+   =================================================================== */
+
+/* --- portada beige con foto (static/img/hero.jpg) --- */
+body.cliente .hero {
+    width: 100%;
+    max-width: 1200px;
+    margin: 0 auto 28px;
+    display: grid;
+    grid-template-columns: 3fr 2fr;
+    border-radius: 16px;
+    overflow: hidden;
+    background: var(--beige-claro);
+}
+
+body.cliente .hero-texto {
+    padding: 32px;
+}
+
+body.cliente .hero-texto h1 {
+    margin: 14px 0 8px;
+    font-size: 34px;
+    font-weight: 700;
+    line-height: 1.2;
+}
+
+body.cliente .hero-texto p {
+    margin: 0 0 10px;
+    color: var(--gris-texto);
+}
+
+body.cliente .hero-texto .hero-datos {
+    color: var(--negro);
+}
+
+/* si no está hero.jpg, queda el bloque beige */
+body.cliente .hero-foto {
+    min-height: 200px;
+    background: var(--beige) url('img/fotoPedidos.png') center / cover no-repeat;
+}
+
+/* --- las dos columnas --- */
+body.cliente .delivery {
+    width: 100%;
+    max-width: 1200px;
+    margin: 0 auto;
+    display: grid;
+    grid-template-columns: 1fr 360px;
+    gap: 28px;
+    align-items: start;
+}
+
+body.cliente .buscador {
+    margin-bottom: 20px;
+    padding: 12px 16px;
+    border: 1px solid #E6DED3;
+    border-radius: 12px;
+    background: var(--blanco);
+}
+
+body.cliente .seccion {
+    margin: 0;
+    font-size: 24px;
+    font-weight: 500;
+}
+
+body.cliente .sub {
+    margin: 2px 0 16px;
+    color: var(--gris-texto);
+    font-size: 14px;
+}
+
+/* --- grilla de tarjetas de platos --- */
+body.cliente .grid-platos {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
+    gap: 18px;
+}
+
+body.cliente .card-plato {
+    display: flex;
+    flex-direction: column;
+    border: 1px solid var(--borde-suave);
+    border-radius: 14px;
+    background: var(--blanco);
+    overflow: hidden;
+}
+
+/* la foto entera, sin recortar el plato */
+body.cliente .card-plato img {
+    width: 100%;
+    aspect-ratio: 16 / 8;
+    object-fit: contain;
+    padding-top: 8px;
+    background: var(--blanco);
+}
+
+body.cliente .card-cuerpo {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    padding: 14px 16px;
+}
+
+body.cliente .card-cuerpo h3 {
+    margin: 0 0 6px;
+    font-size: 16px;
+    font-weight: 500;
+}
+
+body.cliente .card-cuerpo p {
+    flex: 1;
+    margin: 0 0 14px;
+    color: var(--gris-texto);
+    font-size: 13px;
+}
+
+body.cliente .card-pie {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+}
+
+body.cliente .card-pie strong {
+    font-size: 17px;
+    font-weight: 500;
+}
+
+/* botón "+ Agregar" */
+body.cliente button.agregar {
+    width: auto;
+    padding: 6px 14px;
+    background: #FBF3E9;
+    color: var(--dorado-texto);
+    font-weight: 500;
+}
+
+body.cliente button.agregar:hover {
+    background: var(--beige-claro);
+}
+
+/* --- panel "Tu pedido" (sticky: queda quieto arriba al bajar) --- */
+body.cliente .panel-pedido {
+    position: sticky;
+    top: 16px;
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+    padding: 20px;
+    border: 1px solid var(--borde-suave);
+    border-radius: 16px;
+    background: var(--blanco);
+}
+
+body.cliente .panel-titulo h2 {
+    margin: 0;
+    font-size: 22px;
+    font-weight: 500;
+}
+
+/* ⚠️ ADAPTADO AL BACKEND: en Figma se puede elegir "Retiro en local".
+   El backend solo hace envíos a domicilio: queda fijo "Delivery". */
+body.cliente .modo-entrega {
+    padding: 10px;
+    border-radius: 10px;
+    background: #F6F1EA;
+    text-align: center;
+    font-size: 13px;
+    font-weight: 500;
+}
+
+/* "Agregar una nota a la cocina" */
+body.cliente .nota summary {
+    color: var(--dorado-texto);
+    font-size: 13px;
+    font-weight: 500;
+    cursor: pointer;
+}
+
+body.cliente .nota textarea {
+    margin-top: 8px;
+    padding: 8px;
+    border: 1px solid #E6DED3;
+    border-radius: 8px;
+    background: var(--blanco);
+    font-size: 13px;
+    resize: vertical;
+}
+
+body.cliente .pie {
+    display: block;
+    width: 100%;
+    max-width: 1200px;
+    margin: 24px auto 0;
+    color: var(--gris-texto);
+    font-size: 12px;
+}
diff --git a/web/src/main/resources/static/css/paginas/elegir.css b/web/src/main/resources/static/css/paginas/elegir.css
