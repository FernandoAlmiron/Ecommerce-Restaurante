--- /dev/null
+++ b/web/src/main/resources/templates/fragments/cliente/envio-card.html
@@ -0,0 +1,31 @@
+<!-- Una tarjeta de pedido de delivery (diseño nona.css).
+     La usan pedidos.html y perfil.html (Mi cuenta). Necesita ${e} (el Envio). -->
+<article th:fragment="card" class="caja item">
+
+    <div>
+        <!-- el envío no guarda la fecha en que se pidió: se muestra el número -->
+        <p class="titulo" th:text="'Pedido #' + ${e.idEnvio}">Pedido #12</p>
+        <p class="detalle">
+            <th:block th:each="p, i : ${e.ticket.pedidos}"><span th:text="${p.cantidad} + ' × ' + ${p.menu.nombre}">2 × Ravioles</span><span th:unless="${i.last}"> · </span></th:block>
+        </p>
+        <p class="detalle" th:text="'Total $ ' + ${#numbers.formatDecimal(e.ticket.calcularTotal(), 1, 'POINT', 0, 'COMMA')}
+                                     + ' · ' + ${e.direccionEntrega}">Total $ 34.800 · Av. Santa Fe 2450</p>
+    </div>
+
+    <th:block th:replace="~{fragments/cliente/envio-card :: estado}"></th:block>
+
+    <div class="item-acciones">
+        <a th:href="@{/pedidos/{id}(id=${e.idEnvio})}" class="btn btn-suave">Ver detalle</a>
+        <form th:action="@{/pedidos/{id}/repetir(id=${e.idEnvio})}" method="post">
+            <button type="submit" class="btn">Volver a pedir</button>
+        </form>
+    </div>
+</article>
+
+<!-- la etiqueta de color según el estado del envío -->
+<th:block th:fragment="estado" th:switch="${e.estado.name()}">
+    <span th:case="'PENDIENTE'" class="estado aviso">En preparación</span>
+    <span th:case="'EN_CAMINO'" class="estado info">En camino</span>
+    <span th:case="'ENTREGADO'" class="estado ok">Entregado</span>
+    <span th:case="*"           class="estado error">Cancelado</span>
+</th:block>
