+@import url("css/paginas/login.css");
+@import url("css/paginas/registro.css");
+@import url("css/paginas/elegir.css");
+@import url("css/paginas/reservas.css");
+@import url("css/paginas/reserva-nueva.css");
+@import url("css/paginas/delivery.css");
+@import url("css/paginas/delivery-pago.css");
+@import url("css/paginas/pedido.css");
+@import url("css/paginas/pedidos.css");
+@import url("css/paginas/perfil.css");
+@import url("css/paginas/nosotros.css");
+@import url("css/responsive.css");
+@import url("css/tema-oscuro.css");
