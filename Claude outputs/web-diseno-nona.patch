diff --git a/web/src/main/resources/static/css/paginas/inicio.css b/web/src/main/resources/static/css/paginas/inicio.css
new file mode 100644
index 0000000..1e5b9de
--- /dev/null
+++ b/web/src/main/resources/static/css/paginas/inicio.css
@@ -0,0 +1,61 @@
+/* cliente/inicio.html · platos en zigzag */
+
+/* ---------- Página de inicio: platos en zigzag ---------- */
+
+body.cliente .menu-inicio {
+    max-width: 700px;
+    margin: 0 auto;
+    padding: 24px 16px 120px;   /* abajo deja lugar para la barra fija */
+    display: flex;
+    flex-direction: column;
+    gap: 28px;
+}
+
+body.cliente .plato {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    align-items: center;
+    gap: 24px;
+}
+
+/* en las filas invertidas la imagen va a la izquierda */
+body.cliente .plato.invertido .plato-imagen {
+    order: -1;
+}
+
+body.cliente .plato-texto {
+    text-align: center;
+    font-size: 13px;
+    line-height: 1.5;
+}
+
+body.cliente .plato-texto h3 {
+    margin: 0 0 4px;
+    font-size: 14px;
+    font-weight: 500;
+}
+
+body.cliente .plato-texto p {
+    margin: 0 0 4px;
+}
+
+body.cliente .plato-texto .precio {
+    font-weight: 600;
+}
+
+body.cliente .plato-imagen {
+    width: 100%;
+    aspect-ratio: 3 / 2;
+    object-fit: cover;          /* recorta la foto sin deformarla */
+    border-radius: 50%;         /* forma ovalada como en Figma */
+}
+
+/* en celular: una columna, imagen arriba y texto abajo */
+@media (max-width: 600px) {
+    body.cliente .plato {
+        grid-template-columns: 1fr;
+    }
+    body.cliente .plato .plato-imagen {
+        order: -1;
+    }
+}
diff --git a/web/src/main/resources/static/css/paginas/landing.css b/web/src/main/resources/static/css/paginas/landing.css
new file mode 100644
index 0000000..60995d2
--- /dev/null
+++ b/web/src/main/resources/static/css/paginas/landing.css
@@ -0,0 +1,101 @@
+/* cliente/landing.html */
+
+/* ===================================================================
+   -- LANDING --                                 cliente/landing.html
+   La carta pública: platos en zigzag (texto · foto / foto · texto)
+   y el botón "Iniciar / Registrarme" FIJO abajo.
+   =================================================================== */
+
+body.cliente header {
+    margin-bottom: 32px;
+}
+
+body.cliente .carta {
+    width: 100%;
+    max-width: 640px;
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+}
+
+/* cada plato: foto y texto uno al lado del otro */
+body.cliente .plato {
+    display: flex;
+    align-items: center;
+    gap: 24px;
+}
+
+/* zigzag: en los platos impares (1°, 3°, 5°...) el texto va a la
+   izquierda y la foto a la derecha. En el HTML siempre va primero
+   la foto: el orden visual lo da el CSS. */
+body.cliente .plato:nth-child(odd) {
+    flex-direction: row-reverse;
+}
+
+/* la foto ovalada. object-fit: cover la recorta sin deformarla.
+   ⚠️ ADAPTADO AL BACKEND: el plato (Menu) no guarda imagen. Cada foto
+   se busca por el número del plato: static/img/platos/1.jpg, 2.jpg... */
+body.cliente .plato img {
+    flex: 1;
+    width: 50%;
+    aspect-ratio: 3 / 2;
+    object-fit: cover;
+    border-radius: 50%;
+    background: var(--beige-claro);
+}
+
+body.cliente .plato div {
+    flex: 1;
+    text-align: center;
+    font-size: 14px;
+}
+
+body.cliente .plato h3 {
+    margin: 0 0 4px;
+    font-size: 15px;
+    font-weight: 500;
+}
+
+body.cliente .plato p {
+    margin: 0 0 4px;
+}
+
+body.cliente .plato strong {
+    font-weight: 700;
+}
+
+/* --- "Iniciar / Registrarme" fijo abajo ---
+   position: fixed lo deja pegado a la pantalla: cuando bajás con el
+   scroll, los platos pasan por detrás y el botón queda siempre a mano. */
+body.cliente .acciones {
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 10;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 6px;
+    padding: 14px 16px 18px;
+    /* blanco semitransparente con desenfoque: se ve que hay contenido detrás */
+    background: rgba(255, 255, 255, 0.92);
+    backdrop-filter: blur(6px);
+    border-top: 1px solid #F0EAE2;
+}
+
+body.cliente .acciones .boton {
+    width: auto;
+    padding: 10px 36px;
+    color: var(--blanco);
+}
+
+body.cliente .acciones small {
+    color: var(--gris-texto);
+    font-size: 13px;
+}
+
+/* lugar abajo para que el último plato no quede tapado por el botón */
+body.cliente:has(> .acciones) {
+    padding-bottom: 130px;
+}
diff --git a/web/src/main/resources/static/css/paginas/login.css b/web/src/main/resources/static/css/paginas/login.css
new file mode 100644
index 0000000..e11fa10
