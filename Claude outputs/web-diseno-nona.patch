diff --git a/web/src/main/resources/static/css/responsive.css b/web/src/main/resources/static/css/responsive.css
new file mode 100644
index 0000000..51d8645
--- /dev/null
+++ b/web/src/main/resources/static/css/responsive.css
@@ -0,0 +1,194 @@
+/* Tablet y celular: todos los @media juntos (van al final para pisar lo anterior) */
+
+/* ███████████████████████████████████████████████████████████████████
+   PARTE 3 · RESPONSIVE
+   Todo lo que cambia según el tamaño de la pantalla, junto acá.
+   @media (max-width: X) = "aplicá esto solo si la pantalla mide X o menos".
+   ███████████████████████████████████████████████████████████████████ */
+
+
+/* ===================================================================
+   TABLET (hasta 900px): las páginas de varias columnas pasan a una
+   =================================================================== */
+
+@media (max-width: 900px) {
+
+    /* -- DELIVERY: CARTA -- portada arriba de todo, panel debajo de la carta */
+    body.cliente .hero,
+    body.cliente .delivery {
+        grid-template-columns: 1fr;
+    }
+
+    body.cliente .hero-foto {
+        min-height: 160px;
+    }
+
+    body.cliente .panel-pedido {
+        position: static;
+    }
+
+    /* -- DELIVERY: PAGO -- las tres columnas, una debajo de la otra */
+    body.cliente .pago {
+        grid-template-columns: 1fr;
+    }
+
+    body.cliente .pago-resumen {
+        border-left: none;
+        border-top: 1px solid #EFE6DA;
+    }
+
+    /* -- DELIVERY: CONFIRMACIÓN -- */
+    body.cliente .confirmacion {
+        grid-template-columns: 1fr;
+        gap: 32px;
+    }
+
+    /* -- SOBRE NOSOTROS -- las tarjetas de a 2 */
+    body.cliente .equipo {
+        grid-template-columns: repeat(2, 1fr);
+    }
+}
+
+
+/* ===================================================================
+   CELULAR (hasta 600px)
+   =================================================================== */
+
+@media (max-width: 600px) {
+
+    /* -- GENERAL -- menos margen a los costados */
+    body.cliente {
+        padding: 16px 16px 32px;
+    }
+
+    /* barra de abajo más angosta para que entre */
+    body.cliente .nav-inferior {
+        bottom: 12px;
+        max-width: calc(100% - 24px);
+    }
+
+    body.cliente .nav-inferior a {
+        padding: 8px 12px;
+        font-size: 11px;
+    }
+
+    /* título y botón uno debajo del otro (Mis reservas / Mis pedidos) */
+    body.cliente .titulo-con-boton {
+        flex-direction: column;
+        gap: 12px;
+    }
+
+    body.cliente .titulo-con-boton .boton-beige {
+        position: static;
+    }
+
+    body.cliente .titulo-con-boton h1 {
+        font-size: 26px;
+    }
+
+    /* -- LANDING -- los platos se apilan: foto arriba, texto abajo */
+    body.cliente .plato,
+    body.cliente .plato:nth-child(odd) {
+        flex-direction: column;
+        gap: 10px;
+    }
+
+    body.cliente .plato img {
+        width: 85%;
+    }
+
+    body.cliente .acciones .boton {
+        width: 100%;
+    }
+
+    /* -- LOGIN -- logo un poco más chico */
+    body.cliente .auth .logo {
+        width: 220px;
+        margin: 24px auto 36px;
+    }
+
+    /* -- CREAR CUENTA -- */
+    body.cliente .auth:has(input[name="password2"]) h1 {
+        font-size: 28px;
+    }
+
+    /* -- ELEGIR -- */
+    body.cliente .elegir {
+        gap: 40px;
+    }
+
+    body.cliente .opcion img {
+        width: 110px;
+        height: 110px;
+    }
+
+    /* -- REGISTRAR RESERVA -- */
+    body.cliente .registrar-reserva {
+        max-width: 100%;
+    }
+
+    body.cliente .registrar-reserva h1 {
+        margin: 16px 0 24px;
+    }
+
+    /* -- DELIVERY: CARTA -- */
+    body.cliente .hero-texto {
+        padding: 22px;
+    }
+
+    body.cliente .hero-texto h1 {
+        font-size: 26px;
+    }
+
+    body.cliente .grid-platos {
+        grid-template-columns: 1fr;
+    }
+
+    /* -- DELIVERY: PAGO -- */
+    body.cliente .pago > section {
+        padding: 24px 18px;
+    }
+
+    body.cliente .pago-medios h1 {
+        font-size: 24px;
+    }
+
+    body.cliente .volver {
+        top: 22px;
+        left: 18px;
+    }
+
+    /* -- DELIVERY: CONFIRMACIÓN -- */
+    body.cliente .confirmacion {
+        padding: 20px 16px;
+    }
+
+    body.cliente .entrega-estimada strong {
+        font-size: 26px;
+    }
+
+    /* -- PERFIL -- */
+    body.cliente .perfil h1 {
+        font-size: 30px;
+    }
+
+    /* -- SOBRE NOSOTROS -- */
+    body.cliente .nosotros h1 {
+        font-size: 30px;
+    }
+
+    /* botón "Sobre nosotros" un poco más chico */
+    body.cliente .boton-nosotros {
+        top: 12px;
+        right: 12px;
+        padding: 7px 12px;
+        font-size: 12px;
+    }
+}
+
+/* celulares muy angostos: las tarjetas del equipo de a 1 */
+@media (max-width: 400px) {
+    body.cliente .equipo {
+        grid-template-columns: 1fr;
+    }
+}
diff --git a/web/src/main/resources/static/css/tema-oscuro.css b/web/src/main/resources/static/css/tema-oscuro.css
new file mode 100644
index 0000000..f011a7d
--- /dev/null
+++ b/web/src/main/resources/static/css/tema-oscuro.css
@@ -0,0 +1,53 @@
+/* Modo oscuro y botón de cambiar tema */
+
+/* ---------- Modo oscuro ---------- */
+[data-tema="oscuro"] {
+    --blanco: #1e1b18;          /* fondos de tarjetas y botones */
+    --beige: #2a241e;           /* bloques beige */
+    --beige-claro: #352d25;     /* hover */
+    --borde-suave: #4a4036;
+    --dorado-texto: #d9b46a;    /* un dorado más claro para que se lea */
+}
+
+[data-tema="oscuro"] body {
+    background: #141210;
+    color: #ece6dd;
+}
+
+/* botón de cambiar tema, arriba a la izquierda */
+body.cliente .boton-tema {
+    position: fixed;
+    top: 16px;
+    left: 16px;
+    z-index: 20;
+    width: 38px;
+    height: 38px;
+    padding: 0;
+    display: flex;              /* centra el ícono */
+    align-items: center;
+    justify-content: center;
+    font-size: 18px;
+    line-height: 1;
+    overflow: hidden;           /* nada se sale del recuadro */
+    border: 1px solid var(--borde-suave);
+    border-radius: 10px;
+    background: var(--blanco);
+    cursor: pointer;
+}
+
+/* el dibujo de la luna: color fijo, se vea siempre */
+body.cliente .boton-tema svg {
+    width: 18px;
+    height: 18px;
+    flex-shrink: 0;
+    stroke: var(--dorado-texto);
+}
+
+/* en el hover, mismo fondo que "Sobre nosotros" y la luna sigue dorada */
+body.cliente .boton-tema:hover {
+    background: var(--beige-claro);
+}
+
+body.cliente .boton-tema:hover svg {
+    stroke: var(--dorado-texto);
+}
