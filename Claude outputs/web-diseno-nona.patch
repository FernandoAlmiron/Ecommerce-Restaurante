@@ -0,0 +1,67 @@
+/* Base: body, links, imágenes, textos chicos */
+
+/*  BASE */
+
+*,
+*::before,
+*::after {
+    box-sizing: border-box;     /* el padding no agranda las cajas */
+}
+
+body.cliente {
+    margin: 0;
+    min-height: 100vh;
+    background: var(--blanco);
+    color: var(--negro);
+    font-family: var(--fuente);
+    font-weight: 300;
+    font-size: 15px;
+    line-height: 1.5;
+
+    /* centrado en columna */
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    padding: 24px 16px 40px;
+}
+
+body.cliente a {
+    color: var(--negro);
+    font-weight: 500;
+    text-decoration: none;
+}
+
+body.cliente a:hover {
+    text-decoration: underline;
+}
+
+/* las imágenes no se salen de su caja */
+body.cliente img {
+    max-width: 100%;
+}
+
+/* páginas con la barra de abajo: dejan lugar para que no tape nada */
+body.cliente.con-nav {
+    padding-bottom: 110px;
+}
+
+body.cliente.ancho {
+    align-items: stretch;
+    background: var(--crema);
+}
+
+body.cliente.sin-padding {
+    padding: 0;
+}
+
+body.cliente .aclaracion {
+    margin: 0;
+    color: var(--gris-texto);
+    font-size: 12px;
+    text-align: center;
+}
+
+body.cliente .vacio {
+    text-align: center;
+    color: var(--gris-texto);
+}
diff --git a/web/src/main/resources/static/css/base/variables.css b/web/src/main/resources/static/css/base/variables.css
new file mode 100644
index 0000000..00922d4
--- /dev/null
+++ b/web/src/main/resources/static/css/base/variables.css
@@ -0,0 +1,29 @@
+/* Fuentes y colores (variables de :root) */
+
+/*
+   GENERAL FUENTES Y COLORES */
+
+@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;700;800&family=Oswald:wght@500&display=swap');
+
+:root {
+    --dorado:        #A0753A;   /* botones principales */
+    --dorado-oscuro: #87612E;   /* botón al pasar el mouse */
+    --dorado-texto:  #7A5A2E;   /* textos dorados sobre fondo claro */
+    --beige:         #BC9B70;   /* tarjetas de reservas y pedidos */
+    --beige-claro:   #F3E9DC;   /* fondos suaves, contadores */
+    --crema:         #FBF8F4;   /* fondo de las páginas anchas */
+    --borde-suave:   #EBD9C3;   /* bordes de tarjetas y paneles */
+    --marron:        #9A6243;   /* "PRESENCIAL", "DELIVERY" */
+    --gris-input:    #E6E6E6;   /* fondo de los campos */
+    --gris-texto:    #6B6B6B;   /* textos chicos y aclaraciones */
+    --negro:         #1A1A1A;
+    --blanco:        #FFFFFF;
+
+    --error:         #C0392B;
+    --ok:            #2E7D32;
+
+    --fuente:        'Lexend', system-ui, sans-serif;
+    --fuente-titulo: 'Oswald', 'Lexend', sans-serif;
+
+    --radio:         8px;       /* esquinas de botones e inputs */
+}
diff --git a/web/src/main/resources/static/css/componentes/comunes.css b/web/src/main/resources/static/css/componentes/comunes.css
new file mode 100644
index 0000000..8d70c6d
