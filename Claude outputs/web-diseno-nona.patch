-/* ===================================================================
-   -- MIS RESERVAS --                           cliente/reservas.html
-   Título con "+ Nueva Reserva" y las tarjetas beige (ver 3.9).
-   Acá solo van los colores de cada estado de la reserva.
-   =================================================================== */
-
-body.cliente .mis-reservas {
-    width: 100%;
-    max-width: 860px;
-}
-
-body.cliente .estado-confirmada  { color: #C6F29B; }   /* verde */
-body.cliente .estado-pendiente   { color: #FFC24B; }   /* naranja */
-body.cliente .estado-cancelada   { color: #B3261E; }   /* rojo */
