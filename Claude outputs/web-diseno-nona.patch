+}
+
+body.cliente .tarjeta {
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    padding: 14px;
+    border-radius: 20px;
+    background: var(--beige);
+    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
+}
+
+/* fecha y hora más oscuras */
+body.cliente .tarjeta-fecha {
+    display: flex;
+    justify-content: center;
+    gap: 6px;
+}
+
+body.cliente .tarjeta-fecha span {
+    padding: 2px 10px;
+    border-radius: 999px;
+    background: rgba(0, 0, 0, 0.08);
+    font-size: 13px;
+}
+
+/* el estado, en mayúsculas y con color (los colores van en cada página) */
+body.cliente .estado {
+    margin: 0;
+    text-align: center;
+    font-size: 12px;
+    font-weight: 700;
+    letter-spacing: 0.5px;
+}
+
+/* comensales / zona / seña (o artículos / dirección / total) con ícono */
+body.cliente .tarjeta-datos {
+    margin: 0;
+    padding: 0 6px;
+    list-style: none;
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+    font-size: 13px;
+}
+
+body.cliente .tarjeta-datos .icono {
+    display: inline-block;
+    width: 26px;
+}
+
+
+
+/*boton sobre nosotros */
+
+body.cliente .boton-nosotros {
+    position: fixed;
+    top: 16px;
+    right: 16px;
+    z-index: 20;
+    padding: 9px 16px;          /* ahora el tamaño lo da el texto */
+    font-size: 13px;
+    font-weight: 500;
+    white-space: nowrap;        /* que no se parta en dos renglones */
+    border: 1px solid var(--borde-suave);
+    border-radius: 10px;
+    background: var(--blanco);
+    color: var(--dorado-texto);
+    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
+    transition: background 0.2s;
+}
+
+body.cliente .boton-nosotros:hover {
+    background: var(--beige-claro);
+    text-decoration: none;
+}
diff --git a/web/src/main/resources/static/css/nona/base.css b/web/src/main/resources/static/css/nona/base.css
new file mode 100644
index 0000000..763ea23
--- /dev/null
+++ b/web/src/main/resources/static/css/nona/base.css
@@ -0,0 +1,46 @@
+/* 2. Base de las páginas con <body class="nona"> */
+
+/* ---------- 2. Base de la página ---------- */
+
+/* style.css centra todo en una columna angosta: acá se usa el ancho completo */
+body.cliente.nona {
+    display: block;
+    padding: 0 0 110px;            /* lugar para la barra de abajo */
+    background: var(--n-fondo);
+    color: var(--n-texto);
+    font-size: 16px;
+    line-height: 1.55;
+}
+
+body.cliente.nona.publico {
+    padding-bottom: 0;             /* el inicio público no tiene barra de abajo */
+}
+
+body.nona a {
+    color: var(--n-acento-texto);
+}
+
+body.nona img {
+    max-width: 100%;
+}
+
+/* el logo de arriba, con lugar para los botones fijos de tema y "Sobre nosotros" */
+body.nona .cabecera {
+    padding: 64px 16px 8px;
+    text-align: center;
+}
+
+body.nona .cabecera .logo {
+    width: 180px;
+    margin: 0 auto;
+}
+
+/* texto solo para lectores de pantalla */
+body.nona .oculto {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+}
diff --git a/web/src/main/resources/static/css/nona/colores.css b/web/src/main/resources/static/css/nona/colores.css
new file mode 100644
index 0000000..70dbb2f
--- /dev/null
+++ b/web/src/main/resources/static/css/nona/colores.css
@@ -0,0 +1,55 @@
+/* 1. Colores del diseño nuevo, modo claro y modo oscuro */
+
+/* ---------- 1. Colores ---------- */
+
+/* Modo claro. Todo el diseño usa estas variables: para cambiar un color
+   se cambia acá y se actualiza en todas las pantallas. */
+body.nona {
+    --n-fondo:        #FFFFFF;
+    --n-fondo-suave:  #FBF8F4;   /* franjas color crema */
+    --n-beige:        #F3E9DC;   /* franja "Sobre La Nona", contadores */
+    --n-tarjeta:      #FFFFFF;
+    --n-borde:        #EBD9C3;
+    --n-borde-campo:  #D9C7AF;
+    --n-texto:        #1A1A1A;
+    --n-texto-2:      #4A4A4A;   /* bajadas y párrafos */
+    --n-texto-3:      #6B6B6B;   /* aclaraciones chicas */
+    --n-acento:       #87612E;   /* fondo de los botones */
+    --n-sobre-acento: #FFFFFF;   /* texto encima de los botones */
+    --n-acento-texto: #7A5A2E;   /* precios y links */
+    --n-marron:       #9A6243;   /* "PRESENCIAL", "PEDIDO EN CURSO" */
+    --n-pie:          #1A1A1A;
+    --n-pie-texto:    #E8E1D8;
+
+    /* estados: fondo y texto de cada etiqueta */
+    --n-ok-fondo:     #E4F2E6;  --n-ok:     #2E7D32;
+    --n-aviso-fondo:  #FDF0CC;  --n-aviso:  #8A5608;
+    --n-info-fondo:   #E3EEFB;  --n-info:   #1F5FA8;
+    --n-error-fondo:  #FBE3E0;  --n-error:  #B3261E;
+    --n-neutro-fondo: #EDE8E4;  --n-neutro: #5E534B;
+}
+
+/* Modo oscuro: lo activa tema.js poniendo data-tema="oscuro" en <html> */
+[data-tema="oscuro"] body.nona {
+    --n-fondo:        #141210;
+    --n-fondo-suave:  #1B1815;
+    --n-beige:        #2A231C;
+    --n-tarjeta:      #201C18;
+    --n-borde:        #3A322A;
+    --n-borde-campo:  #54493E;
+    --n-texto:        #F1EBE3;
+    --n-texto-2:      #CFC6BA;
+    --n-texto-3:      #A69C90;
+    --n-acento:       #D3A867;   /* dorado claro: en oscuro el botón va con texto oscuro */
+    --n-sobre-acento: #1A1410;
+    --n-acento-texto: #E0BE84;
+    --n-marron:       #D9A27F;
+    --n-pie:          #0C0B09;
+    --n-pie-texto:    #CFC6BA;
+
+    --n-ok-fondo:     #1D3322;  --n-ok:     #8FD19A;
+    --n-aviso-fondo:  #3A2E10;  --n-aviso:  #F2C46B;
+    --n-info-fondo:   #16283D;  --n-info:   #8DB8EE;
+    --n-error-fondo:  #3D1A17;  --n-error:  #F19A92;
+    --n-neutro-fondo: #2C2621;  --n-neutro: #CFC6BA;
+}
diff --git a/web/src/main/resources/static/css/nona/comunes.css b/web/src/main/resources/static/css/nona/comunes.css
new file mode 100644
index 0000000..4029c0f
--- /dev/null
+++ b/web/src/main/resources/static/css/nona/comunes.css
@@ -0,0 +1,278 @@
+/* 3. Piezas comunes: contenedor, títulos, botones, campos, estados, tarjeta de plato */
+
+/* ---------- 3. Piezas comunes ---------- */
+
+body.nona .contenedor {
+    max-width: 1200px;
+    margin: 0 auto;
+    padding-inline: 24px;
+}
+
+/* franjas de la página: cada sección es una franja de color */
+body.nona .franja             { padding-block: 88px; }
+body.nona .franja.suave       { background: var(--n-fondo-suave); }
+body.nona .franja.beige       { background: var(--n-beige); }
+
+body.nona .titulo-seccion,
+body.nona .titulo-pagina {
+    margin: 0;
+    font-family: var(--fuente-titulo);
+    font-weight: 600;
+    line-height: 1.1;
+    color: var(--n-texto);
+}
+
+body.nona .titulo-seccion { font-size: 40px; }
+body.nona .titulo-pagina  { font-size: 44px; }
+
+body.nona .bajada {
+    margin: 8px 0 0;
+    max-width: 40em;
+    font-size: 18px;
+    color: var(--n-texto-2);
+}
+
+body.nona .volanta {                 /* textito en mayúsculas arriba de un título */
+    margin: 0;
+    font-size: 13px;
+    font-weight: 600;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+    color: var(--n-marron);
+}
+
+/* título a la izquierda y algo (link o botón) a la derecha */
+body.nona .encabezado-seccion {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: flex-end;
+    gap: 16px;
+    margin-bottom: 32px;
+}
+
+/* grilla que se acomoda sola: tantas columnas como entren */
+body.nona .grilla {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+    gap: 24px;
+}
+
+/* dos columnas que en pantallas chicas se apilan */
+body.nona .dos-columnas {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 32px;
+    align-items: flex-start;
+}
+
+body.nona .dos-columnas > .principal { flex: 999 1 600px; min-width: 0; }
+body.nona .dos-columnas > .lateral   { flex: 1 1 340px;   min-width: 0; }
+
+/* caja blanca con borde */
+body.nona .caja {
+    background: var(--n-tarjeta);
+    border: 1px solid var(--n-borde);
+    border-radius: 16px;
+    padding: 24px;
+}
+
+/* --- botones --- */
+body.nona .btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 8px;
+    width: auto;
+    min-height: 44px;
+    padding: 12px 24px;
+    border: 1px solid var(--n-acento);
+    border-radius: 8px;
+    background: var(--n-acento);
+    color: var(--n-sobre-acento);
+    font-family: var(--fuente);
+    font-size: 16px;
+    font-weight: 500;
+    line-height: 1.2;
+    text-decoration: none;
+    cursor: pointer;
+}
+
+body.nona .btn:hover {
+    filter: brightness(0.92);
+    text-decoration: none;
+}
+
+body.nona .btn-borde {
+    background: transparent;
+    color: var(--n-texto);
+    border-color: var(--n-texto);
+}
+
+body.nona .btn-suave {
+    background: var(--n-tarjeta);
+    color: var(--n-texto);
+    border-color: var(--n-borde-campo);
+}
+
+body.nona .btn-peligro {
+    background: var(--n-tarjeta);
+    color: var(--n-error);
+    border-color: var(--n-borde-campo);
+}
+
+body.nona .btn-bloque { width: 100%; }
+
+body.nona .btn.deshabilitado {
+    opacity: 0.5;
+    pointer-events: none;
+}
+
+body.nona .link-flecha {
+    font-weight: 500;
+    padding-block: 12px;
+}
+
+/* --- campos de formulario ---
+   style.css ya tiene una clase .campo (caja con borde para el formulario viejo):
+   acá se le sacan el borde y el recorte para usar el diseño nuevo */
+body.nona .campo {
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+    border: 0;
+    border-radius: 0;
+    overflow: visible;
+    font-size: 14px;
+    font-weight: 500;
+    color: var(--n-texto);
+}
+
+body.nona .campo span {
+    flex: none;
+    padding: 0;
+    border: 0;
+    font-size: inherit;
+}
+
+body.nona .campo input,
+body.nona .campo select,
+body.nona .campo textarea {
+    flex: none;
+    width: 100%;
+    margin: 0;
+    padding: 12px 14px;
+    border: 1px solid var(--n-borde-campo);
+    border-radius: 8px;
+    background: var(--n-tarjeta);
+    color: var(--n-texto);
+    font-family: var(--fuente);
+    font-size: 16px;
+    font-weight: 300;
+}
+
+body.nona .campo input:focus,
+body.nona .campo select:focus,
+body.nona .campo textarea:focus {
+    outline: 2px solid var(--n-acento);
+    outline-offset: 1px;
+}
+
+/* en modo oscuro, los íconos de fecha y hora en claro */
+[data-tema="oscuro"] body.nona .campo input {
+    color-scheme: dark;
+}
+
+/* --- etiquetas de estado (Confirmada, En camino, Entregado...) --- */
+body.nona .estado {
+    display: inline-block;
+    margin: 0;
+    padding: 5px 12px;
+    border-radius: 999px;
+    font-size: 13px;
+    font-weight: 600;
+    letter-spacing: 0;
+    text-transform: none;
+    white-space: nowrap;
+}
+
+body.nona .estado.ok     { background: var(--n-ok-fondo);     color: var(--n-ok); }
+body.nona .estado.aviso  { background: var(--n-aviso-fondo);  color: var(--n-aviso); }
+body.nona .estado.info   { background: var(--n-info-fondo);   color: var(--n-info); }
+body.nona .estado.error  { background: var(--n-error-fondo);  color: var(--n-error); }
+body.nona .estado.neutro { background: var(--n-neutro-fondo); color: var(--n-neutro); }
+
+body.nona .alerta {
+    margin: 0 0 16px;
+    padding: 12px 16px;
+    border-radius: 10px;
+}
+
+body.nona .alerta.error { background: var(--n-error-fondo); color: var(--n-error); }
+body.nona .alerta.ok    { background: var(--n-ok-fondo);    color: var(--n-ok); }
+
+body.nona .nota-caja {                /* aviso beige (la seña, por ejemplo) */
+    margin: 0;
+    padding: 12px 16px;
+    border-radius: 10px;
+    background: var(--n-beige);
+    color: var(--n-texto-2);
+    font-size: 15px;
+}
+
+body.nona .vacio {
+    color: var(--n-texto-3);
+    text-align: left;
+}
+
+/* --- tarjeta de plato (inicio y delivery) --- */
+body.nona .plato-card {
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+    background: var(--n-tarjeta);
+    border: 1px solid var(--n-borde);
+    border-radius: 16px;
+}
+
+body.nona .plato-card img {
+    display: block;
+    width: 100%;
+    aspect-ratio: 3 / 2;
+    object-fit: cover;
+    background: #FFFFFF;             /* las fotos tienen fondo blanco */
+}
+
+body.nona .plato-card .cuerpo {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+    padding: 18px 20px 20px;
+}
+
+body.nona .plato-card h3 {
+    margin: 0;
+    font-size: 17px;
+    font-weight: 600;
+    line-height: 1.3;
+    color: var(--n-texto);
+}
+
+body.nona .plato-card p {
+    flex: 1;
+    margin: 0;
+    font-size: 14px;
+    color: var(--n-texto-3);
+}
+
+body.nona .precio {
+    font-size: 18px;
+    font-weight: 600;
+    color: var(--n-acento-texto);
+}
+
+/* --- barra de abajo (la de ustedes) un poco más alta para el dedo --- */
+body.nona .nav-inferior a {
+    padding: 10px 18px;
+}
diff --git a/web/src/main/resources/static/css/nona/cuenta.css b/web/src/main/resources/static/css/nona/cuenta.css
new file mode 100644
index 0000000..72ecb95
--- /dev/null
+++ b/web/src/main/resources/static/css/nona/cuenta.css
@@ -0,0 +1,73 @@
+/* 7. Mi cuenta, pedidos y reservas (perfil, pedidos, reservas) */
+
+/* ---------- 7. Mi cuenta, pedidos y reservas ---------- */
+
+body.nona .saludo { margin: 0; color: var(--n-texto-3); }
+
+body.nona .lista {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+}
+
+body.nona .lista h2,
+body.nona .datos-cuenta h2 {
+    margin: 0;
+    font-size: 24px;
+    font-weight: 600;
+}
+
+/* el pedido que está en camino, destacado */
+body.nona .pedido-curso {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    border: 2px solid var(--n-acento);
+}
+
+body.nona .pedido-curso h3 { margin: 4px 0 0; font-size: 22px; font-weight: 600; }
+body.nona .pedido-curso .encabezado-seccion { margin: 0; }
+body.nona .pedido-curso .btn { align-self: flex-start; }
+body.nona .pedido-curso .detalle { margin: 0; color: var(--n-texto-2); }
+
+/* fila de botones que se acomoda sola */
+body.nona .botones {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+}
+
+/* una fila de pedido o de reserva */
+body.nona .item {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 12px 16px;
+    padding: 20px 24px;
+}
+
+body.nona .item .titulo   { margin: 0; font-weight: 600; font-size: 17px; }
+body.nona .item .detalle  { margin: 0; color: var(--n-texto-2); font-size: 15px; }
+body.nona .item-acciones   { display: flex; flex-wrap: wrap; gap: 8px; }
+body.nona .item form      { margin: 0; }
+
+body.nona .datos-cuenta {
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+}
+
+body.nona .datos-cuenta dl {
+    display: grid;
+    grid-template-columns: max-content 1fr;
+    gap: 8px 16px;
+    margin: 0;
+    font-size: 15px;
+}
+
+body.nona .datos-cuenta dt { color: var(--n-texto-3); }
+body.nona .datos-cuenta dd { margin: 0; overflow-wrap: anywhere; }
+
+body.nona .detalle-reserva summary { cursor: pointer; font-size: 14px; font-weight: 500; color: var(--n-acento-texto); }
+body.nona .detalle-reserva p       { margin: 4px 0 0; font-size: 14px; color: var(--n-texto-3); }
diff --git a/web/src/main/resources/static/css/nona/delivery.css b/web/src/main/resources/static/css/nona/delivery.css
new file mode 100644
index 0000000..e6dac8c
--- /dev/null
+++ b/web/src/main/resources/static/css/nona/delivery.css
@@ -0,0 +1,182 @@
+/* 5. Delivery (cliente/delivery.html) */
+
+/* ---------- 5. Delivery ---------- */
+
+body.nona .pagina {
+    padding-block: 24px 48px;
+}
+
+body.nona .pagina-cabecera {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: flex-end;
+    gap: 16px;
+    margin-bottom: 24px;
+}
+
+body.nona .abierto {
+    margin: 0;
+    font-size: 14px;
+    font-weight: 500;
+    color: var(--n-ok);
+}
+
+body.nona .buscador-nona {
+    flex: 0 1 360px;
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 2px 18px;
+    border: 1px solid var(--n-borde-campo);
+    border-radius: 999px;
+    background: var(--n-tarjeta);
+}
+
+body.nona .buscador-nona svg { flex-shrink: 0; stroke: var(--n-texto-3); }
+
+body.nona .buscador-nona input {
+    flex: 1;
+    min-width: 0;
+    margin: 0;
+    padding: 10px 0;
+    border: 0;
+    outline: none;
+    background: transparent;
+    color: var(--n-texto);
+    font-family: var(--fuente);
+    font-size: 16px;
+}
+
+body.nona .grid-delivery {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
+    gap: 20px;
+}
+
+body.nona .plato-pie {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 8px;
+    margin-top: 10px;
+}
+
+/* botón "+ Agregar" */
+body.nona button.agregar {
+    width: auto;
+    min-height: 44px;
+    padding: 10px 16px;
+    border: 1px solid var(--n-acento);
+    border-radius: 999px;
+    background: var(--n-tarjeta);
+    color: var(--n-acento-texto);
+    font-family: var(--fuente);
+    font-size: 15px;
+    font-weight: 500;
+    cursor: pointer;
+}
+
+body.nona button.agregar:hover { background: var(--n-beige); }
+
+/* contador − 2 + */
+body.nona .contador {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    padding: 2px;
+    border-radius: 999px;
+    background: var(--n-beige);
+}
+
+body.nona .contador button {
+    width: 40px;
+    height: 40px;
+    padding: 0;
+    border: 0;
+    border-radius: 999px;
+    background: var(--n-tarjeta);
+    color: var(--n-texto);
+    font-size: 20px;
+    line-height: 1;
+    cursor: pointer;
+}
+
+body.nona .contador button:last-child {
+    background: var(--n-acento);
+    color: var(--n-sobre-acento);
+}
+
+body.nona .contador span {
+    min-width: 24px;
+    text-align: center;
+    font-weight: 600;
+}
+
+/* panel "Tu pedido" */
+body.nona .panel-nona {
+    position: sticky;
+    top: 24px;
+    display: flex;
+    flex-direction: column;
+    gap: 18px;
+}
+
+body.nona .panel-nona h2 {
+    margin: 0;
+    font-size: 22px;
+    font-weight: 600;
+}
+
+body.nona .lineas-nona {
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+}
+
+body.nona .lineas-nona li {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+body.nona .lineas-nona img {
+    width: 56px;
+    height: 56px;
+    object-fit: cover;
+    border-radius: 10px;
+    background: #FFFFFF;
+}
+
+body.nona .lineas-nona .info {
+    flex: 1;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    font-size: 15px;
+}
+
+body.nona .lineas-nona small { color: var(--n-texto-3); font-size: 14px; }
+
+body.nona .total-nona {
+    display: flex;
+    justify-content: space-between;
+    padding-top: 16px;
+    border-top: 1px solid var(--n-borde);
+    font-size: 20px;
+    font-weight: 600;
+}
+
+body.nona .aclaracion-nona {
+    margin: 0;
+    font-size: 13px;
+    color: var(--n-texto-3);
+    text-align: center;
+}
+
+body.nona .nota summary { cursor: pointer; font-weight: 500; }
+body.nona .nota .campo  { margin-top: 8px; }
diff --git a/web/src/main/resources/static/css/nona/inicio.css b/web/src/main/resources/static/css/nona/inicio.css
