diff --git a/web/src/main/resources/static/style.css b/web/src/main/resources/static/style.css
index e0ade23..d2ce193 100644
--- a/web/src/main/resources/static/style.css
+++ b/web/src/main/resources/static/style.css
@@ -2158,4 +2158,33 @@ body.cliente .volver-atras {
     body.cliente .equipo {
         grid-template-columns: 1fr;
     }
-}
\ No newline at end of file
+}
+
+/* ---------- PIE DE PÁGINA EN TODAS LAS PÁGINAS ----------
+   El footer va al final de cada página (fragmento "footer" de layout.html).
+   - margin-top: auto lo empuja hasta abajo de todo en las páginas cortas
+     (login, elegir...). El borde transparente de arriba deja 32px de aire
+     entre el contenido y el footer, sin pintarlos de beige.
+   - El body no deja espacio abajo: el espacio lo pone el footer, así queda
+     pegado al borde de la pantalla.
+   - Si la página tiene la barra de abajo (INICIO · PEDIDOS...) o el botón
+     fijo "Iniciar / Registrarme", el footer deja lugar para que no lo tapen. */
+
+body.cliente .footer {
+    margin-top: auto;
+    border-top: 32px solid transparent;
+    background-clip: padding-box;
+    padding-bottom: 24px;
+}
+
+body.cliente:has(> .footer) {
+    padding-bottom: 0;
+}
+
+body.cliente:has(> .nav-inferior) .footer {
+    padding-bottom: 96px;
+}
+
+body.cliente:has(> .acciones) .footer {
+    padding-bottom: 120px;
+}
