            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Postman\",\n  \"celular\": \"1155559999\",\n  \"dni\": {{dniNuevo}},\n  \"email\": \"ana.postman@example.com\",\n  \"restaurante\": {\n    \"nroRestaurante\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear reserva con sena",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"nroReserva\", pm.response.json().nroReserva);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 1);",
                  "pm.collectionVariables.set(\"fechaManana\", d.toISOString().slice(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantComensales\": 2,\n  \"fechaReserva\": \"{{fechaManana}}\",\n  \"horaReserva\": \"21:00\",\n  \"cliente\": {\n    \"idCliente\": {{idCliente}},\n    \"dni\": {{dniCliente}}\n  },\n  \"zona\": {\n    \"idZona\": 2\n  },\n  \"restaurante\": {\n    \"nroRestaurante\": 1\n  },\n  \"senia\": {\n    \"tarjeta\": {\n      \"titular\": \"ANA POSTMAN\",\n      \"vencimiento\": \"2029-08\"\n    }\n  }\n}",
              "options": {
